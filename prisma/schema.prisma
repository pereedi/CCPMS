datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Core identity ────────────────────────────────────────────────────────────

model AuthorizedUser {
  username     String   @id                  // KingsChat handle, lowercase, no @
  name         String
  role         String                        // "OFEM" | "AD" | "BOTH"
  directorate  String?                       // one of 7 directorate codes; nullable for pure-OFEM users
  email        String?
  profilePhoto String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  records      Record[] @relation("RecordSubmitter")
  asSubject    Review[] @relation("ReviewSubject")
  asReviewer   Review[] @relation("ReviewerUser")
}

// ─── Directorate ──────────────────────────────────────────────────────────────

model Organization {
  id           String        @id @default(uuid())
  name         String
  code         String        @unique
  description  String?
  directorates Directorate[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Directorate {
  id             String       @id @default(uuid())
  name           String
  code           String       @unique
  description    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ─── Submissions & Reviews ────────────────────────────────────────────────────

model Record {
  id          String         @id @default(uuid())
  username    String
  submitter   AuthorizedUser @relation("RecordSubmitter", fields: [username], references: [username])
  records     String                         // JSON string: { type, period, summary, kpi_results[], file_url? }
  submittedAt DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Review {
  id                String         @id @default(uuid())
  username          String                       // whose record is being reviewed
  subject           AuthorizedUser @relation("ReviewSubject",  fields: [username],          references: [username])
  reviewersUsername String                       // must resolve to OFEM or BOTH
  reviewer          AuthorizedUser @relation("ReviewerUser",   fields: [reviewersUsername],  references: [username])
  report_url        String                       // R2/B2 object URL
  status            String         @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedAt        DateTime?
  createdAt         DateTime       @default(now())
}

// ─── Notifications & Audit ────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  username  String                       // target user's KingsChat handle
  title     String
  message   String
  type      String   @default("INFO")   // INFO | APPROVAL_REQUEST | ALERT | DEADLINE
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  username  String?                      // nullable — system actions have no user
  action    String
  resource  String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}
